# Copy to .env and adjust. All values have sensible defaults.

# --- Storage ---
# SESSION_DIR=.sessions
SESSION_TTL_MINUTES=120

# --- Upload limits ---
MAX_UPLOAD_MB=50
MAX_FILES_PER_SESSION=10

# --- Query execution ---
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=30

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- LLM ---
# "groq" (hosted, free tier, open-weights Llama) or "ollama" (fully local).
# See docs/decisions/0002-open-weights-llm-via-groq.md.
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Only used when LLM_PROVIDER=ollama. Run `ollama pull qwen2.5-coder:7b` first.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# LLM_TIMEOUT_SECONDS=20
# SQL_REPAIR_ATTEMPTS=1
